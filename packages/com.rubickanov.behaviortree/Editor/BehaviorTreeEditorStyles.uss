GridBackground {
    --grid-background-color: #282828;
    --line-color: rgba(255, 255, 255, 0.05);
    --thick-line-color: rgba(255, 255, 255, 0.1);
    --spacing: 25;
}

.bt-node {
    min-width: 150px;
}

.bt-node .unity-label {
    font-size: 12px;
}

.bt-node #title {
    min-height: 28px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    justify-content: center;
}

.bt-node #title-label {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
}

.bt-node #title-button-container {
    display: none;
}

.bt-node #collapse-button {
    display: none;
}

.bt-node-composite #title {
    background-color: #E8A035;
}

.bt-node-composite #title-label {
    color: #1a1a1a;
}

.bt-node-decorator #title {
    background-color: #5B9BD5;
}

.bt-node-decorator #title-label {
    color: #1a1a1a;
}

.bt-node-action #title {
    background-color: #6FAF6F;
}

.bt-node-action #title-label {
    color: #1a1a1a;
}

.bt-node-condition #title {
    background-color: #A577C0;
}

.bt-node-condition #title-label {
    color: #1a1a1a;
}

.bt-node-subtree #title {
    background-color: #4DB6AC;
}

.bt-node-subtree #title-label {
    color: #1a1a1a;
}

.bt-state-running #node-border {
    border-left-color: #FFEB3B;
    border-right-color: #FFEB3B;
    border-top-color: #FFEB3B;
    border-bottom-color: #FFEB3B;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.bt-state-success #node-border {
    border-left-color: #4CAF50;
    border-right-color: #4CAF50;
    border-top-color: #4CAF50;
    border-bottom-color: #4CAF50;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.bt-state-failure #node-border {
    border-left-color: #F44336;
    border-right-color: #F44336;
    border-top-color: #F44336;
    border-bottom-color: #F44336;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.bt-node-invalid #node-border {
    border-left-color: #FF5722;
    border-right-color: #FF5722;
    border-top-color: #FF5722;
    border-bottom-color: #FF5722;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.bt-node-invalid #title-label {
    color: #FF5722;
}

.bt-node-incomplete #node-border {
    border-left-color: #6E6E6E;
    border-right-color: #6E6E6E;
    border-top-color: #6E6E6E;
    border-bottom-color: #6E6E6E;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.bt-node-orphan #node-border {
    opacity: 0.6;
    border-left-color: #FF9800;
    border-right-color: #FF9800;
    border-top-color: #FF9800;
    border-bottom-color: #FF9800;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.bt-node-root #node-border {
    border-left-color: #FFD700;
    border-right-color: #FFD700;
    border-top-color: #FFD700;
    border-bottom-color: #FFD700;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

#inspector-container {
    background-color: #383838;
    min-width: 250px;
}

.panel-header {
    -unity-font-style: bold;
    font-size: 14px;
    padding: 8px;
    border-bottom-color: #222222;
    border-bottom-width: 1px;
}

.inspector-description {
    font-size: 11px;
    color: #aaaaaa;
    padding: 4px 8px 8px 8px;
    white-space: normal;
    border-bottom-color: #222222;
    border-bottom-width: 1px;
}

.node-description {
    font-size: 11px;
    color: #cccccc;
    padding: 4px 8px;
    white-space: normal;
    background-color: #333333;
    -unity-text-align: middle-center;
}

/* Own port containers — bypass default #input/#output styling entirely */
.bt-port-area {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: #2b2b2b;
    overflow: visible;
}

#port-input {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding-top: 2px;
    padding-bottom: 4px;
}

#port-input .port {
    margin-top: -13px;
}

#port-output {
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-top: 4px;
    padding-bottom: 2px;
}

#port-output .port {
    margin-bottom: -13px;
}

/* Port connector — hollow by default (empty socket half-circle) */
.bt-port-area .port > #connector {
    border-radius: 8px;
    width: 14px;
    height: 14px;
    background-color: rgba(0, 0, 0, 0);
    border-color: #c8c8c8;
    border-width: 2px;
}

/* Connected — filled (line "caps" into the half-circle) */
.bt-port-area .bt-port-connected > #connector {
    background-color: #c8c8c8;
}

.bt-port-area .port:hover > #connector {
    border-color: #ffffff;
}

.bt-port-area .bt-port-connected:hover > #connector {
    background-color: #ffffff;
}

/* Minimap */
MiniMap {
    background-color: rgba(30, 30, 30, 0.9);
    border-color: #555555;
    border-width: 1px;
    border-radius: 4px;
}

/* Kill the port label — we don't need it in BT */
.bt-port-area .port > #type {
    display: none;
}

/* Hide the cap dot inside the connector */
.bt-port-area .port > #connector > #cap {
    display: none;
}
