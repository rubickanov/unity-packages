#dev-console-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    background-color: rgba(15, 15, 20, 0.92);
    border-bottom-width: 2px;
    border-bottom-color: rgba(80, 160, 255, 0.6);
    flex-direction: column;
}

/* Log area */
#log-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

#log-scroll .unity-scroll-view__content-container {
    padding: 6px 10px;
}

/* Scrollbar */
#log-scroll .unity-scroller--vertical {
    width: 6px;
}

#log-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

#log-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(100, 120, 160, 0.3);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
}

#log-scroll .unity-scroller--vertical .unity-repeat-button {
    display: none;
}

#log-scroll .unity-scroller--vertical .unity-base-slider__drag-container {
    margin: 0;
    padding: 0;
}

#log-container {
    flex-direction: column;
}

.log-entry {
    font-size: 14px;
    color: rgba(220, 220, 220, 1);
    white-space: normal;
    padding: 1px 0;
    margin: 0;
}

.log-info {
    color: rgba(220, 220, 220, 1);
}

.log-warning {
    color: rgba(255, 210, 60, 1);
}

.log-error {
    color: rgba(255, 80, 80, 1);
}

.log-success {
    color: rgba(80, 220, 100, 1);
}

.log-input {
    color: rgba(160, 160, 170, 1);
}

/* Autocomplete dropdown */
#autocomplete-container {
    flex-direction: column;
    flex-shrink: 0;
    background-color: rgba(20, 20, 28, 0.95);
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 160, 255, 0.2);
    padding: 2px 0;
    display: none;
    max-height: 250px;
}

.ac-row {
    flex-direction: row;
    padding: 2px 10px;
}

.ac-row-selected {
    background-color: rgba(60, 90, 140, 0.5);
}

.ac-name {
    font-size: 13px;
    color: rgba(200, 210, 230, 1);
    min-width: 160px;
    margin: 0;
    padding: 0;
}

.ac-desc {
    font-size: 13px;
    color: rgba(120, 130, 150, 0.7);
    margin: 0;
    padding: 0;
}

/* Input row */
#input-row {
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: rgba(80, 160, 255, 0.25);
    padding: 4px 10px;
    min-height: 28px;
    flex-shrink: 0;
}

#prompt-label {
    font-size: 14px;
    color: rgba(80, 160, 255, 0.9);
    margin-right: 4px;
    flex-shrink: 0;
}

#command-input {
    flex-grow: 1;
    font-size: 14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(230, 230, 230, 1);
    margin: 0;
    padding: 0;
}

#command-input .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(230, 230, 230, 1);
    padding: 2px 0;
    margin: 0;
    font-size: 14px;
    --unity-cursor-color: rgba(220, 225, 240, 0.9);
}

#command-input:focus .unity-text-field__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
