<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="DevConsoleUI.uss"/>
    <ui:VisualElement name="dev-console-root">
        <ui:ScrollView name="log-scroll" mode="Vertical">
            <ui:VisualElement name="log-container"/>
        </ui:ScrollView>
        <ui:VisualElement name="autocomplete-container"/>
        <ui:VisualElement name="input-row">
            <ui:Label name="prompt-label" text="&gt; "/>
            <ui:TextField name="command-input"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
